<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>game.bubblesCollected %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld سیپی جمع ہوئی</string>
			<key>other</key>
			<string>%lld سیپیاں جمع ہوئیں</string>
		</dict>
	</dict>
	<key>home.nextCharacter %lld %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$@ کو کھولنے کے لیے مزید %1$lld سیپی</string>
			<key>other</key>
			<string>%2$@ کو کھولنے کے لیے مزید %1$lld سیپیاں</string>
		</dict>
	</dict>
	<key>home.pausedCards %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld سیپی رکی ہوئی گیم میں محفوظ</string>
			<key>other</key>
			<string>%lld سیپیاں رکی ہوئی گیم میں محفوظ</string>
		</dict>
	</dict>
	<key>levelIntro.cardsBullet %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
