		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>اس لیول میں تم زیادہ سے زیادہ **%lld سیپی** جمع کر سکتے ہو۔</string>
			<key>other</key>
			<string>اس لیول میں تم زیادہ سے زیادہ **%lld سیپیاں** جمع کر سکتے ہو۔</string>
		</dict>
	</dict>
