		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld دن ہو گیا ہے۔ آؤ کچھ حساب کے سوال حل کریں اور مزید سیپیاں جمع کریں!</string>
			<key>other</key>
			<string>%lld دن ہو گئے ہیں۔ آؤ کچھ حساب کے سوال حل کریں اور مزید سیپیاں جمع کریں!</string>
		</dict>
