		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Nog %1$lld skulp om %2$@ te ontsluit</string>
			<key>other</key>
			<string>Nog %1$lld skulpe om %2$@ te ontsluit</string>
		</dict>
