		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>तुम्हारे पास कुल %lld सीपी है। कुछ और इकट्ठी करने के लिए तैयार हो?</string>
			<key>other</key>
			<string>तुम्हारे पास कुल %lld सीपियाँ हैं। कुछ और इकट्ठी करने के लिए तैयार हो?</string>
		</dict>
