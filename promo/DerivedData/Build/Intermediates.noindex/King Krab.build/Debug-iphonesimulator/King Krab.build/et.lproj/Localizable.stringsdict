		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Kogutud %lld merekarp</string>
			<key>other</key>
			<string>Kogutud %lld merekarpi</string>
		</dict>
	</dict>
