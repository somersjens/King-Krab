			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ቀን አልፏል። ጥቂት የሂሳብ ጥያቄዎችን እንፍታና ተጨማሪ ዛጎሎችን እንሰብስብ!</string>
			<key>other</key>
			<string>%lld ቀናት አልፈዋል። ጥቂት የሂሳብ ጥያቄዎችን እንፍታና ተጨማሪ ዛጎሎችን እንሰብስብ!</string>
		</dict>
