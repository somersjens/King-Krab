			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%2$@ খোলিবলৈ আৰু %1$lldটা শামুকৰ খোলা</string>
			<key>other</key>
