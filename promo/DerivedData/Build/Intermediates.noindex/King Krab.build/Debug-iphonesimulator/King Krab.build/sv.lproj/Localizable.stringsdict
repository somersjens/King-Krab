		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld snäcka samlad</string>
			<key>other</key>
			<string>%lld snäckor samlade</string>
		</dict>
	</dict>
