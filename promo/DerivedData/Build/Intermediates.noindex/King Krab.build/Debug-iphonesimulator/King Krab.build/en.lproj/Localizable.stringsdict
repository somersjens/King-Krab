		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld shell collected</string>
			<key>other</key>
			<string>%lld shells collected</string>
		</dict>
	</dict>
