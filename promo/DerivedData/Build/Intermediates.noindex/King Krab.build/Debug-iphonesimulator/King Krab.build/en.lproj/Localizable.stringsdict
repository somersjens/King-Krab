	<key>streak.accessibility.compact %@ %lld %lld %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$@ goal: %2$lld of %3$#@minutes@. Streak: %4$#@days@.</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%4$lld day</string>
			<key>other</key>
			<string>%4$lld days</string>
		</dict>
		<key>minutes</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%3$lld minute</string>
			<key>other</key>
			<string>%3$lld minutes</string>
