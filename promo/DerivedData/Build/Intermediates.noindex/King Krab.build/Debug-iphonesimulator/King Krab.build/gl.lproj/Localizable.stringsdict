		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld cuncha recollida</string>
			<key>other</key>
			<string>%lld cunchas recollidas</string>
		</dict>
	</dict>
