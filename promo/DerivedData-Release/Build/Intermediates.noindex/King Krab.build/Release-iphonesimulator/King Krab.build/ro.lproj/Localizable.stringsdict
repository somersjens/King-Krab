			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Ai în total %lld scoică. Gata pentru încă câteva?</string>
			<key>other</key>
			<string>Ai în total %lld scoici. Gata pentru încă câteva?</string>
