	<key>notif.day3.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld-मिनिटांचे खेळण्याचे सत्र सुरू करा आणि तुमचा दैनंदिन खेळण्याचा सिलसिला वाढवा.</string>
			<key>other</key>
			<string>%lld-मिनिटांचे खेळण्याचे सत्र सुरू करा आणि तुमचा दैनंदिन खेळण्याचा सिलसिला वाढवा.</string>
		</dict>
	</dict>
	<key>notif.premium.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>प्रीमियममध्ये प्रत्येक विषयासाठी %lld स्तर आणि सर्व 10 प्राण्यांचा समावेश आहे. साहस चालूच राहते!</string>
			<key>other</key>
			<string>प्रीमियममध्ये प्रत्येक विषयासाठी %lld स्तर आणि सर्व 10 प्राण्यांचा समावेश आहे. साहस चालूच राहते!</string>
		</dict>
	</dict>
	<key>notif.reactivate.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld दिवस झाला. चल, काही गणितं सोडवू आणि आणखी शिंपले गोळा करू!</string>
			<key>other</key>
			<string>%lld दिवस झाले. चल, काही गणितं सोडवू आणि आणखी शिंपले गोळा करू!</string>
		</dict>
	</dict>
	<key>notif.streak.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld मिनिटे खेळा आणि तुमचा रोजचा खेळ सुरू ठेवा!</string>
			<key>other</key>
			<string>%lld मिनिटे खेळा आणि तुमचा रोजचा खेळ सुरू ठेवा!</string>
		</dict>
