		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld دېڭىز قېپى توختىتىلغان ئويۇندا ساقلانغان</string>
			<key>other</key>
			<string>%lld دېڭىز قېپى توختىتىلغان ئويۇندا ساقلانغان</string>
		</dict>
