		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ਦਿਨ ਹੋ ਗਿਆ ਹੈ। ਆਓ ਕੁਝ ਹਿਸਾਬ ਦੇ ਸਵਾਲ ਹੱਲ ਕਰੀਏ ਅਤੇ ਹੋਰ ਸੀਪੀਆਂ ਇਕੱਠੀਆਂ ਕਰੀਏ!</string>
			<key>other</key>
			<string>%lld ਦਿਨ ਹੋ ਗਏ ਹਨ। ਆਓ ਕੁਝ ਹਿਸਾਬ ਦੇ ਸਵਾਲ ਹੱਲ ਕਰੀਏ ਅਤੇ ਹੋਰ ਸੀਪੀਆਂ ਇਕੱਠੀਆਂ ਕਰੀਏ!</string>
