		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Таны өдөр тутмын тоглолтын цуврал %lld хоног боллоо! 🔥</string>
			<key>other</key>
			<string>Таны өдөр тутмын тоглолтын цуврал %lld хоног боллоо! 🔥</string>
		</dict>
