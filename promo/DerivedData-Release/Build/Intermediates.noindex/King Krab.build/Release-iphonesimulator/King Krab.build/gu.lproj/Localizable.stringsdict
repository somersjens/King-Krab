	<key>notif.day3.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld-મિનિટનું રમતનું સત્ર શરૂ કરો અને તમારી દૈનિક રમવાની સ્ટ્રીકને લંબાવો.</string>
			<key>other</key>
			<string>%lld-મિનિટનું રમતનું સત્ર શરૂ કરો અને તમારી દૈનિક રમવાની સ્ટ્રીકને લંબાવો.</string>
		</dict>
	</dict>
	<key>notif.premium.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>પ્રીમિયમમાં દરેક વિષય માટે %lld સ્તરો અને તમામ 10 પ્રાણીઓનો સમાવેશ થાય છે. સાહસ ચાલુ રહે છે!</string>
			<key>other</key>
			<string>પ્રીમિયમમાં દરેક વિષય માટે %lld સ્તરો અને તમામ 10 પ્રાણીઓનો સમાવેશ થાય છે. સાહસ ચાલુ રહે છે!</string>
		</dict>
	</dict>
	<key>notif.reactivate.body %lld</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld દિવસ થયો. ચાલો થોડા ગણિતના દાખલા ઉકેલીએ અને વધુ છીપો ભેગી કરીએ!</string>
			<key>other</key>
			<string>%lld દિવસ થયા. ચાલો થોડા ગણિતના દાખલા ઉકેલીએ અને વધુ છીપો ભેગી કરીએ!</string>
		</dict>
	</dict>
