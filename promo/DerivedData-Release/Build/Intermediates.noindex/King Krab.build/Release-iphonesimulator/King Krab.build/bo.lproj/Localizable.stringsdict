			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>མཚམས་བཞག་པའི་རྩེད་མོའི་ནང་ཉ་ཕྱིས་ %lld ཉར་ཡོད།</string>
			<key>other</key>
			<string>མཚམས་བཞག་པའི་རྩེད་མོའི་ནང་ཉ་ཕྱིས་ %lld ཉར་ཡོད།</string>
		</dict>
