			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>ഈ ആഴ്ച %lld ചിപ്പി! 🎉</string>
			<key>other</key>
			<string>ഈ ആഴ്ച %lld ചിപ്പികൾ! 🎉</string>
