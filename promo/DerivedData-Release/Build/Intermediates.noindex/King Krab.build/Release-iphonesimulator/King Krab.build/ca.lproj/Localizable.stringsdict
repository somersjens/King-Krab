		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Falta %1$lld petxina per desbloquejar %2$@</string>
			<key>other</key>
			<string>Falten %1$lld petxines per desbloquejar %2$@</string>
		</dict>
