			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld दिन भयो। केही हिसाबका प्रश्न हल गरौँ र अझ धेरै सिपीहरू सङ्कलन गरौँ!</string>
			<key>other</key>
			<string>%lld दिन भए। केही हिसाबका प्रश्न हल गरौँ र अझ धेरै सिपीहरू सङ्कलन गरौँ!</string>
		</dict>
