		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld bhlaosc bailithe</string>
			<key>other</key>
			<string>%lld blaosc bailithe</string>
		</dict>
	</dict>
